# Server & Port
PORT=5000
NODE_ENV=development

# Supabase (Database, Auth, Row Level Security)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agridirect
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agridirect
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=agridirect_super_secure_jwt_secret_key_2026_prod
JWT_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agridirect-produce
S3_REGION=ap-south-1

# AI Microservice URL (Python OR-Tools & LightGBM)
AI_SERVICE_URL=http://localhost:8000

# Agmarknet / APMC Mandi Benchmark API
AGMARKNET_API_KEY=mock_agmarknet_key
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in
